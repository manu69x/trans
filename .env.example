# Trans — backend/worker configuration
#
# Copy to `.env` next to `infra/docker-compose.yml` (compose reads it
# automatically) and adjust. Every value has a local-dev default; you only
# need to set the LLM gateway settings to get inference working.

# --- LLM Gateway (the only inference path, PRD §8 / ADR-001) ---------------
# Any OpenAI-compatible LOCAL server: llama.cpp (llama-server / llama-swap),
# vLLM, LM Studio, Ollama's OpenAI shim, ...
LLM_GATEWAY_BASE_URL=http://host.docker.internal:8080/v1
LLM_GATEWAY_API_KEY=sk-local-dev-change-me

# --- Segment quality estimation (optional, see deploy/qe-service) ----------
# Empty = derive from the gateway (/upstream/qe upstream route).
QE_BASE_URL=
QE_MODEL=qe-verify

# --- Default models for NEW projects ---------------------------------------
# Must match model ids exposed by YOUR gateway (GET /v1/models).
TRANS_DEFAULT_TRANSLATION_MODEL=translategemma-27b-it
# Optional: used when the primary model returns the source untranslated.
# Empty = disabled.
TRANS_FALLBACK_TRANSLATION_MODEL=
TRANS_DEFAULT_TEXT_MODEL=
TRANS_DEFAULT_TEMPERATURE=0.2
TRANS_DEFAULT_TOP_P=0.9
TRANS_DEFAULT_TOP_K=40
TRANS_DEFAULT_REASONING=none
TRANS_DEFAULT_MAX_OUTPUT_TOKENS=16384

# --- Auth (§2.1) ------------------------------------------------------------
# Bootstrap admin, seeded idempotently at backend boot. CHANGE IN ANY REAL
# USE; the prod profile requires explicit values.
SEED_ADMIN_EMAIL=admin@trans.local
SEED_ADMIN_PASSWORD=trans-admin
# 1 = disable login entirely (every anonymous request is admin). Air-gapped
# single-user machines only.
AUTH_DISABLED=0

# --- Secrets (dev defaults; the prod profile forces real ones) --------------
JWT_SECRET=dev-insecure-change-me

# --- Frontend (server-side targets inside the compose network) --------------
# BACKEND_URL is set by the compose file; override only for exotic setups.
# LLM_GATEWAY_URL is the target of the /api/gateway/* server-side proxy.
# LLM_GATEWAY_URL=http://host.docker.internal:8080

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
POSTGRES_DB=trans
